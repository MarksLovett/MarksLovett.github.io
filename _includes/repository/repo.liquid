{% assign repo_url = include.repository | split: '/' %}
{% comment %}
  Local repository card image.
  Put the file at: assets/img/repositories/repos/<repo-name>.png
  Example for MarksLovett/InflGame -> assets/img/repositories/repos/InflGame.png
{% endcomment %}
{% assign repo_img = '/assets/img/repositories/repos/' | append: repo_url[1] | append: '.png' %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.repository }}">
    <img
      class="w-100"
      alt="{{ include.repository }}"
      src="{{ repo_img | relative_url }}"
    >
  </a>
</div>
