{% comment %}
  Local user card image.
  Put the file at: assets/img/repositories/users/<username>.png
{% endcomment %}
{% assign user_img = '/assets/img/repositories/users/' | append: include.username | append: '.png' %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.username }}">
    <img
      class="w-100"
      alt="{{ include.username }} GitHub profile"
      src="{{ user_img | relative_url }}"
    >
  </a>
</div>
